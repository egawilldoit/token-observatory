# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Prefer a Supabase secret key (sb_secret_...) when available.
# Never expose this value to the browser.
SUPABASE_SECRET_KEY=your-server-secret-key

# Comma-separated login emails permitted to access telemetry.
# The app exposes no signup UI. Also disable new-user signups in the dedicated
# Supabase Auth project and create allowed users administratively.
TOKEN_OBSERVATORY_ALLOWED_EMAILS=you@example.com

# Optional overrides
CCUSAGE_IMPORT_BUCKET=raw-imports

# Server-only OpenCode Go API key for live monthly usage.
# Never expose this value to the browser, logs, storage, or API responses.
OPENCODE_GO_API_KEY=your-opencode-go-api-key

# Optional server-only secret protecting /api/opencode-go/collect for Vercel Cron.
# Configure the same value as the cron Authorization bearer token.
CRON_SECRET=your-cron-secret
