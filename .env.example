# Public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Prefer a Supabase secret key (sb_secret_...) when available.
# Never expose this value to the browser.
SUPABASE_SECRET_KEY=your-server-secret-key

# Comma-separated login emails permitted to access telemetry.
# Self-sign-up is disabled in the app; create these users in Supabase Auth.
TOKEN_OBSERVATORY_ALLOWED_EMAILS=you@example.com

# Optional overrides
CCUSAGE_IMPORT_BUCKET=raw-imports
